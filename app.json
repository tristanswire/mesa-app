{
  "expo": {
    "name": "Mesa",
    "slug": "mesa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "mesa",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F2EA"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tristanswire.mesa",
      "buildNumber": "8",
      "infoPlist": {
        "AppGroup": "group.com.tristanswire.mesa.shared",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.tristanswire.mesa.shared"
        ]
      }
    },
    "platforms": [
      "ios"
    ],
    "plugins": [
      "expo-font",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/timer-complete.wav"
          ]
        }
      ],
      "expo-audio",
      "expo-asset",
      [
        "expo-share-extension",
        {
          "activationRules": [
            {
              "type": "url",
              "max": 1
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "MesaShareExtension",
                  "bundleIdentifier": "com.tristanswire.mesa.ShareExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.tristanswire.mesa.shared"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "f4689da4-9787-4e0f-ad3b-ea4b1652ff0c"
      },
      "appleApplicationGroup": "group.com.tristanswire.mesa.shared"
    },
    "owner": "tristanswire"
  }
}
