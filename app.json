{
  "expo": {
    "name": "Mesa",
    "slug": "mesa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "mesa",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F2EA"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tristanswire.mesa",
      "infoPlist": {
        "AppGroup": "group.com.tristanswire.mesa.shared"
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.tristanswire.mesa.shared"
        ]
      }
    },
    "platforms": [
      "ios"
    ],
    "plugins": [
      "expo-font",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/timer-complete.wav"
          ]
        }
      ],
      "expo-audio",
      "expo-asset",
      [
        "expo-share-extension",
        {
          "activationRules": [
            { "type": "url", "max": 1 }
          ]
        }
      ]
    ]
  }
}
